---
import { site } from "../config/site";
import { formatRange } from "../lib/hours";
import { navLinks } from "../lib/nav";
import { instagramUrl, whatsappLink } from "../lib/whatsapp";

const links = navLinks();
const year = new Date().getFullYear();

// Collapse the week into "Mon–Sat 10 AM – 8 PM"-style lines so the footer shows
// the hours without repeating the full table from the Visit section.
const openDays = site.hours.filter((h) => !h.closed);
const closedDays = site.hours.filter((h) => h.closed);
---

<footer class="bg-primary px-5 py-16 text-background sm:px-8 sm:py-20">
  <div class="mx-auto w-full max-w-5xl">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Identity -->
      <div class="lg:col-span-2">
        <p class="font-heading text-2xl">{site.business.name}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-background/70">
          {site.business.tagline}
        </p>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex rounded-full border border-background/30 px-5 py-2.5 text-sm transition-colors hover:bg-background/10"
        >
          Book on WhatsApp
        </a>
      </div>

      <!-- Links -->
      {
        links.length > 0 && (
          <nav aria-label="Footer">
            <h2 class="font-body text-xs font-medium uppercase tracking-[0.18em] text-background/65">
              Explore
            </h2>
            <ul class="mt-4 space-y-2.5">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-background/80 transition-colors hover:text-background"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <!-- Contact -->
      <div>
        <h2 class="font-body text-xs font-medium uppercase tracking-[0.18em] text-background/65">
          Find us
        </h2>
        <address class="mt-4 space-y-2.5 text-sm not-italic text-background/80">
          <p>{site.location.addressLine}</p>
          <p>{site.location.city}, {site.location.country}</p>
          <p>
            <a href={`tel:${site.contact.phone}`} class="transition-colors hover:text-background">
              {site.contact.phoneDisplay}
            </a>
          </p>
          <p>
            <a href={`mailto:${site.contact.email}`} class="transition-colors hover:text-background">
              {site.contact.email}
            </a>
          </p>
          <p>
            <a
              href={instagramUrl()}
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-background"
            >
              {site.contact.instagram}
            </a>
          </p>
        </address>
      </div>
    </div>

    <!-- Hours strip -->
    {
      openDays.length > 0 && (
        <div class="mt-12 border-t border-background/15 pt-8 text-sm text-background/70">
          <ul class="flex flex-wrap gap-x-8 gap-y-2">
            {openDays.map((entry) => (
              <li>
                <span class="text-background/65">{entry.day.slice(0, 3)}</span>{" "}
                {formatRange(entry)}
              </li>
            ))}
            {closedDays.map((entry) => (
              <li class="text-background/65">
                <span class="text-background/65">{entry.day.slice(0, 3)}</span> Closed
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div
      class="mt-8 flex flex-col gap-2 border-t border-background/15 pt-8 text-xs text-background/65 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.business.name}. All rights reserved.</p>
      {
        site.footer.credit && (
          <p>
            {site.footer.creditUrl ? (
              <a
                href={site.footer.creditUrl}
                target="_blank"
                rel="noopener"
                class="transition-colors hover:text-background"
              >
                {site.footer.credit}
              </a>
            ) : (
              site.footer.credit
            )}
          </p>
        )
      }
    </div>
  </div>
</footer>
