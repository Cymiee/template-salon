---
import { site } from "../config/site";
import Section from "./Section.astro";

const testimonials = site.testimonials;
---

<Section
  id="reviews"
  eyebrow="Kind words"
  heading="What guests say"
  surface
>
  <ul class="grid gap-6 sm:gap-8 lg:grid-cols-3">
    {
      testimonials.map((testimonial, index) => (
        <li
          class="reveal flex flex-col rounded-sm border border-line bg-background p-7 sm:p-8"
          style={`transition-delay:${Math.min(index, 3) * 80}ms`}
        >
          {/*
            The stars are decoration; the rating is announced once as text so a
            screen reader hears "5 out of 5" rather than five separate glyphs.
          */}
          <p class="flex gap-1" role="img" aria-label={`${testimonial.rating} out of 5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                class:list={[
                  "h-4 w-4",
                  i < testimonial.rating ? "text-accent" : "text-line",
                ]}
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.1l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z" />
              </svg>
            ))}
          </p>

          <blockquote class="mt-5 grow">
            <p class="text-base leading-relaxed text-ink/90">{testimonial.text}</p>
          </blockquote>

          <p class="mt-6 text-sm font-medium text-muted">{testimonial.name}</p>
        </li>
      ))
    }
  </ul>
</Section>
