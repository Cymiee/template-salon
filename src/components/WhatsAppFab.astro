---
import { site } from "../config/site";
import { whatsappLink } from "../lib/whatsapp";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const href = whatsappLink();
const label = `Book ${site.business.name} on WhatsApp`;
---

<!--
  Floating booking button. `bottom` uses the iOS safe-area inset so it clears the
  home indicator on notched phones instead of sitting under it.
-->
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
  class="fixed right-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition-transform hover:scale-105 sm:right-6 sm:h-16 sm:w-16"
  style="bottom: calc(1rem + env(safe-area-inset-bottom, 0px))"
>
  <WhatsAppIcon class="h-7 w-7 sm:h-8 sm:w-8" />
</a>
